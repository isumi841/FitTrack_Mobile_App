{
  "expo": {
    "name": "FitTrack",
    "slug": "FitTrack_Mobile_App",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/fittrack_app_icon.png",

    "scheme": "fittrackmobileapp",
    "userInterfaceStyle": "automatic",

    "ios": {
    "usesAppleSignIn": true,
    "icon": "./assets/images/fittrack_app_icon.png"
      },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fittrack_app_icon.png",
        "backgroundColor": "#07130F"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07130F",
          "image": "./assets/images/fittrack_app_icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}