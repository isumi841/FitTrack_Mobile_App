NODE_ENV=development
PORT=5001
MONGODB_URI=
EMAIL_MODE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Local SMTP testing only; ignored when NODE_ENV=production.
SMTP_ALLOW_SELF_SIGNED=false
# Use the same Gmail account for EMAIL_USER and EMAIL_FROM.
EMAIL_USER=
# Use a Google App Password, not the normal Gmail password.
EMAIL_PASS=
EMAIL_FROM=
# For local OTP logging without SMTP, set EMAIL_MODE=development.
OTP_EXPIRY_MINUTES=5

# Comma-separated browser origins allowed to call this backend.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

# Google Web OAuth client ID (first entry is used for browser authorization).
# Additional mobile IDs may be comma-separated for direct ID-token validation.
GOOGLE_CLIENT_ID=
# Backend only: never use an EXPO_PUBLIC variable for this secret.
GOOGLE_CLIENT_SECRET=
# iOS bundle identifier(s), comma-separated; must have Sign in with Apple enabled.
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set the supported API version from your Meta app dashboard, e.g. vXX.0.
FACEBOOK_GRAPH_VERSION=
# Public HTTPS backend origin for registered provider callbacks, no trailing path.
SOCIAL_CALLBACK_BASE_URL=
# Exact app/web returns, e.g. fittrackmobileapp://member1_onboarding_personalization/oauth-callback,http://localhost:8081/member1_onboarding_personalization/oauth-callback
AUTH_REDIRECT_URIS=
