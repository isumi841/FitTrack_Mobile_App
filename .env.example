# Public API address used by the Expo app (never add backend credentials here).
EXPO_PUBLIC_API_URL=http://localhost:5001

# Native application identifiers registered with Apple/Google; public values.
# Set these locally or in your EAS build environment before building.
FITTRACK_IOS_BUNDLE_IDENTIFIER=
FITTRACK_ANDROID_PACKAGE=

# Google/Facebook client IDs and secrets belong in backend/.env.
# Their browser OAuth returns through the backend, so the app needs only API_URL.

# For a physical phone, replace localhost with your computer's LAN IPv4 address.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:5001
