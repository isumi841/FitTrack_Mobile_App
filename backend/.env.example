PORT=5001
# Leader workout collection on the same cluster; read-only integration.
WORKOUT_DATABASE=fittrack_db
NODE_ENV=development
MONGODB_URI=mongodb+srv://fittrack_member3_min:<db_password>@cluster0.wlobfx4.mongodb.net/test?authSource=admin&appName=Cluster0
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# Local web testing only. Requires NODE_ENV=development and database /test.
MEMBER3_DEV_AUTH=false
# Generate 32 random bytes as 64 hex characters; never put this in EXPO_PUBLIC_*.
MEMBER3_DEV_TOKEN=<private_random_64_character_hex_token>
# Separate local admin identity for exercise management. Never reuse the user token.
ADMIN_DEV_AUTH=false
ADMIN_DEV_TOKEN=<different_private_random_64_character_hex_token>

# Member 1 authentication (shared server)
# Generate JWT_SECRET locally; keep it private.
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
# development: verification codes print in the backend terminal (no SMTP needed).
# smtp: sends real email; fill EMAIL_USER/EMAIL_PASS/EMAIL_FROM below (required in production).
EMAIL_MODE=development
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_ALLOW_SELF_SIGNED=false
OTP_EXPIRY_MINUTES=5

# Optional social sign-in provider configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=
SOCIAL_CALLBACK_BASE_URL=
AUTH_REDIRECT_URIS=
# Optional Member4 profile photos (server only; configure privately).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
